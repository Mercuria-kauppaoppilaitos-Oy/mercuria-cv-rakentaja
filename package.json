{
  "name": "mercuria-cv",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "postinstall": "node scripts/patch-pdf-actual-text.mjs",
    "dev": "vite",
    "dev:full": "vercel dev --local --listen 127.0.0.1:3000",
    "build": "tsc --noEmit && tsc --project tsconfig.server.json --noEmit && vite build && node scripts/check-client-build.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "preview": "vite preview",
    "test:production": "node scripts/smoke-production.mjs"
  },
  "dependencies": {
    "@fontsource/lato": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@react-pdf/renderer": "^4.9.0",
    "buffer": "^6.0.3",
    "openai": "^7.18.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-easy-crop": "^6.2.3",
    "react-hook-form": "^7.88.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "axe-core": "^4.13.0",
    "jsdom": "^30.1.0",
    "pdfjs-dist": "^6.3.289",
    "typescript": "~5.9.3",
    "vercel": "^59.23.1",
    "vite": "^8.0.0",
    "vitest": "^4.1.11"
  }
}
